# ============================================================
# Semantic EO Search — Configuration
# ============================================================
# Copy this file to .env and adjust values as needed.

# Core paths
DATA_DIR=./data/archive
MODEL_PATH=./models/clip-vit-b-32
FAISS_INDEX_PATH=./indexes/main.index
DATABASE_PATH=./data/archive/metadata.db

# Offline mode — set to true for air-gapped environments
OFFLINE_MODE=true

# Tiling configuration
TILE_SIZE=256
TILE_OVERLAP=32

# Search defaults
DEFAULT_TOP_K=20

# Embedding model
EMBEDDING_MODEL=clip-vit-b-32
# Device: cpu or cuda
DEVICE=cpu

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend (for CORS)
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=INFO
